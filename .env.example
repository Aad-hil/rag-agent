# Application
APP_ENV=development

# Database
DATABASE_URL=postgresql+psycopg://rag_user:rag_password@localhost:5432/rag_agent

# Vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# LLM
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=gemma3

# LangSmith observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-agent

# Keep secrets in .env only; never commit them.
